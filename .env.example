# Copy to .env and fill in. .env is gitignored and must stay that way.
# Base Sepolia ONLY. Keys here are disposable and must never touch mainnet.

CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SPEND_PERMISSION_MANAGER=0xf85210B21cC50302F477BA56686d2019dC9b67Ad
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
SPEND_ROUTER=

EXECUTOR_ADDRESS=
EXECUTOR_PRIVATE_KEY=

MERCHANT_TREASURY_ADDRESS=
MERCHANT_TREASURY_PRIVATE_KEY=

# scripted CoinbaseSmartWallet for the six-mode drills (owner = TEST_USER)
TEST_SMART_WALLET=

TEST_USER_ADDRESS=
TEST_USER_PRIVATE_KEY=

DATABASE_URL=
BASESCAN_API_KEY=

# Aceternity UI Pro registry (shadcn header expansion). Never commit the value.
ACETERNITY_UI_API_KEY=

# Enables the five review actions. Unset (or anything but "true") means denied,
# so a deployment is read-only unless it deliberately opts in. The public
# deployment leaves this unset.
RETAINER_ENABLE_REVIEW_WRITES=true
